# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Application ID (right sidebar in Developer Portal)
CLIENT_ID=your_application_id_here

# DeepL API key (https://www.deepl.com/pro-api)
DEEPL_API_KEY=your_deepl_api_key_here

# DeepL tuning (optional)
# Model goal: quality_optimized (best) or latency_optimized (fastest). Default: quality_optimized.
# Voice always uses latency_optimized regardless of this value.
DEEPL_MODEL_TYPE=quality_optimized
# Formality: default | more | less | prefer_more | prefer_less (leave unset for DeepL default)
# DEEPL_FORMALITY=less
# Keep Markdown/punctuation intact. Default: true.
DEEPL_PRESERVE_FORMATTING=true
# Sentence splitting: default | on | off | nonewlines (leave unset for DeepL default)
# DEEPL_SPLIT_SENTENCES=default

# Prior channel messages sent to DeepL as context (0 disables). Default: 3.
TRANSLATOR_CONTEXT_MESSAGES=3

# Turso database (optional — for persistent storage on Railway)
# Create a free database at https://turso.tech
# TURSO_URL=libsql://str-discord-bot-username.turso.io
# TURSO_TOKEN=your_turso_auth_token

# Groq API key for speech-to-text (free tier: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional HTTP proxy for Edge TTS synthesis (http://host:port).
# Only needed if Microsoft's TTS endpoint is geo-blocked from your host region.
# EDGE_TTS_PROXY=http://user:pass@proxy.example.com:8080
